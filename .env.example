PRINTLE_PORT=8080
PRINTLE_DATABASE_PASSWORD=replace-with-a-long-random-database-password
PRINTLE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Optional. Leave as a placeholder to create the first admin in the Getting started dialog.
PRINTLE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
PRINTLE_DEFAULT_MONTHLY_PAGE_QUOTA=100
PRINTLE_SECURE_COOKIES=false
PRINTLE_QUOTA_TIMEZONE=UTC
PRINTLE_HELD_JOB_TTL=24h
PRINTLE_COMPLETED_JOB_RETENTION=720h
PRINTLE_FAILED_JOB_RETENTION=168h
